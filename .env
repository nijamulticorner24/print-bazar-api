# ============================================================
# PRINT BAZZAR 2.0 - API ENVIRONMENT VARIABLES
# ============================================================

NODE_ENV=development
PORT=4000
API_PREFIX=api/v1
CORS_ORIGIN=http://localhost:3000

# PostgreSQL Database URL
DATABASE_URL=postgresql://postgres:12345@localhost:5432/printbazzar_dev?schema=public

# Redis & BullMQ
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT Secrets
JWT_SECRET=super_secret_jwt_key_print_bazzar_2_development_only_change_in_production
JWT_EXPIRATION=86400s
REFRESH_TOKEN_SECRET=refresh_secret_jwt_key_print_bazzar_2_development_only
REFRESH_TOKEN_EXPIRATION=604800s

# Storage (S3 / Local)
STORAGE_DRIVER=local
S3_ENDPOINT=http://localhost:9000
S3_REGION=ap-south-1
S3_BUCKET_NAME=printbazzar-artwork
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_FORCE_PATH_STYLE=true
LOCAL_STORAGE_DIR=./uploads

# Payments (Razorpay)
RAZORPAY_KEY_ID=rzp_test_placeholder_key
RAZORPAY_KEY_SECRET=rzp_test_placeholder_secret
RAZORPAY_WEBHOOK_SECRET=rzp_webhook_secret_placeholder

# Shipping
SHIPPING_PROVIDER=mock
DELHIVERY_API_TOKEN=mock_token
SHIPROCKET_API_TOKEN=mock_token

# Email & Notifications
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Print Bazzar 2.0 <notifications@printbazzar.com>"
